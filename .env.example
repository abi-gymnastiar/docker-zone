# Port exposed on the host for the dashboard.
DASHBOARD_PORT=8080

# Address used by the dashboard inside the container.
LISTEN_ADDR=:8080

# Host Docker socket path.
DOCKER_SOCKET=/var/run/docker.sock

# PostgreSQL connection used by the dashboard.
DATABASE_URL=postgres://dashboard:change-me@postgres:5432/dashboard?sslmode=disable
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me
