# Port exposed on the host for the dashboard.
DASHBOARD_PORT=8080

# Address used by the dashboard inside the container.
LISTEN_ADDR=:8080

# Host Docker socket path.
DOCKER_SOCKET=/var/run/docker.sock

# Created only when the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Host directory where the SQLite database is stored.
DATABASE_DIR=./data

# SQLite database path inside the container.
DATABASE_PATH=/data/dashboard.db

# Server-wide YAML configuration path.
CONFIG_PATH=/data/config.yml

# Optional values used only when config.yml is created for the first time.
WEB_TITLE=
WEB_ICON=
WEB_HEADER=
WEB_SUBHEADER=
WEB_FOOTER=
